# ============================================================
# Security & Environment Configuration Template (.env.example)
# Copy this file to the project root as `.env` and fill in values
# ============================================================

# --- AI & Search API Keys ---
GROQ_API_KEY=your_groq_api_key_here
SERPER_API_KEY=your_serper_dev_api_key_here
OPENAI_API_BASE=http://localhost:1234/v1

# --- Database (MongoDB Atlas) ---
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# --- Security & Authentication (JWT & Admin) ---
JWT_SECRET=replace_with_a_strong_256_bit_secret_key
ADMIN_EMAIL=admin@example.com
